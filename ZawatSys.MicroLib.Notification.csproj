<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <RootNamespace>ZawatSys.MicroLib.Notification</RootNamespace>
    <AssemblyName>ZawatSys.MicroLib.Notification</AssemblyName>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageId>ZawatSys.MicroLib.Notification</PackageId>
    <Version>2.0.0</Version>
    <Authors>ZawatSys Team</Authors>
    <Company>ZawatSys</Company>
    <Product>ZawatSys Notification Domain Library</Product>
    <Description>Domain library for Notification microservice following DDD and CQRS patterns</Description>
    <PackageTags>zawatsys;microlib;notification;ddd;cqrs</PackageTags>
    <RepositoryUrl>https://github.com/A95H/ZawatSys.MicroLib.Notification</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ZawatSys.MicroLib.Shared" Version="2.0.0" />
  </ItemGroup>

</Project>
